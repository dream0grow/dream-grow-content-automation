# ─────────────────────────────────────────────────────────────
# Instagram AutoDM 환경 변수 (.env 로 복사해서 사용)
# ─────────────────────────────────────────────────────────────

# Meta 앱 대시보드 > Instagram > API setup with Instagram business login > 3. Set up Instagram business login
#   > Business login settings 에 있는 "Instagram app ID" / "Instagram app secret" (앱 설정>기본 설정의 Meta 앱 ID 와 다릅니다!)
IG_APP_ID=
IG_APP_SECRET=

# (권장) 앱 설정 > 기본 설정 > "앱 시크릿 코드" (Meta 앱 시크릿). 웹훅 서명 검증 시 두 시크릿 중 하나라도 맞으면 통과
META_APP_SECRET=

# 서버가 외부에서 접근되는 공개 URL (https 필수). 예: https://autodm.example.com
# OAuth redirect_uri 와 웹훅 콜백 URL 이 여기서 파생됩니다.
#   redirect_uri : {PUBLIC_URL}/auth/instagram/callback
#   webhook      : {PUBLIC_URL}/webhook
PUBLIC_URL=http://localhost:3000

# 웹훅 검증 토큰 (아무 문자열. Meta 앱 대시보드 > Webhooks 설정에 동일하게 입력)
WEBHOOK_VERIFY_TOKEN=change-me-verify-token

# 대시보드 접속 비밀번호 (HTTP Basic Auth. 아이디는 아무거나)
DASHBOARD_PASSWORD=change-me

# 서버 포트
PORT=3000

# SQLite DB 파일 경로 (배포 시 영구 볼륨에 두세요)
DB_PATH=./data/autodm.sqlite

# Graph API 버전
IG_API_VERSION=v23.0

# 웹훅이 오지 않을 때(앱 검수 전 등) 댓글을 주기적으로 조회하는 폴백. 1 이면 켜짐
COMMENT_POLLING=0
COMMENT_POLL_INTERVAL_SEC=120

# (선택) AI 문구 변형에 사용. 없으면 기능이 자동으로 꺼집니다.
ANTHROPIC_API_KEY=

# (개발용) 1 이면 Instagram API 를 호출하지 않고 가짜 응답으로 동작합니다.
MOCK_INSTAGRAM=0
